{
  "name": "@daltn/interactive-chat",
  "version": "0.1.0",
  "description": "Daltn Interactive Chat: validated, provider-neutral controls for agent conversations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/interactive.css",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./src/interactive.css"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
